# Reel-Watcher Environment Configuration Template
# Copy this file to .env and insert your optional API keys.

# LLM & Vision Providers (Optional - Only required for deep multi-modal VLM deconstruction)
# Zero-cost local Whisper transcription and metadata extraction work out-of-the-box without keys.
OPENROUTER_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=

# Default Models
OPENROUTER_MODEL=google/gemini-2.5-pro
GEMINI_MODEL=gemini-2.5-flash

# Storage & Paths
REEL_WATCHER_VAULT_DIR=vault
REEL_WATCHER_DOWNLOADS_DIR=vault/downloads
REEL_WATCHER_DB_PATH=vault/reels.db

# Chrome Remote Debugging (CDP)
REEL_WATCHER_CDP_URL=http://127.0.0.1:9222
